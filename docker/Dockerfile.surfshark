FROM golang:1.27.1-bookworm AS go-build

WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY cmd/ocpool-egress ./cmd/ocpool-egress
RUN CGO_ENABLED=0 GOOS=linux GOARCH=amd64 go build -trimpath -ldflags='-s -w' -o /out/ocpool-egress ./cmd/ocpool-egress

FROM ubuntu:24.04
ENV DEBIAN_FRONTEND=noninteractive OCPOOL_VPN_BACKEND=wireguard
RUN apt-get update && apt-get install -y --no-install-recommends \
      ca-certificates curl iproute2 iptables iputils-ping wireguard-tools \
    && rm -rf /var/lib/apt/lists/*
COPY --from=go-build /out/ocpool-egress /usr/local/bin/ocpool-egress
COPY ops/wireguard/entrypoint.sh /usr/local/bin/ocpool-wireguard-entrypoint
RUN chmod 0755 /usr/local/bin/ocpool-egress /usr/local/bin/ocpool-wireguard-entrypoint
EXPOSE 18071
ENTRYPOINT ["/usr/local/bin/ocpool-wireguard-entrypoint"]
